# Database Configuration
# For local demo, npm run demo automatically uses an in-memory MongoDB.
# Set MONGODB_URI if you want to connect to a real MongoDB instance.
# MONGODB_URI=mongodb://localhost:27017/ronansat

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=demo-secret-key-ronansat-123456789

# Optional: Google Gemini API Key for live AI SAT tutor explanations
# If omitted or left empty, the app runs gracefully in offline fallback demo mode.
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Cloudinary configuration for admin student card uploads
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
