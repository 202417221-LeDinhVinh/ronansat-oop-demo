flowchart LR
    Student["fa:fa-user Student<br/>(Authenticated User)"]

    subgraph SystemBoundary ["RonanSAT Platform — Student Practice & Assessment"]
        direction TB

        subgraph AssessmentFlow ["Practice & Assessment Module"]
            direction TB
            subgraph Row1 [" "]
                direction LR
                UC_Browse(["Browse Practice Tests & Leaderboard"])
                UC_TakeTest(["Take Timed Practice Test (with Desmos)"])
            end
            subgraph Row2 [" "]
                direction LR
                UC_Submit(["Submit Answers & Calculate Score"])
                UC_Review(["Review Test Results & Explanations"])
            end
            Row1 ~~~ Row2
        end

        subgraph AITutorFlow ["AI Tutoring System"]
            direction LR
            UC_Chat(["Chat with AI Tutor for Guidance"])
        end
        AssessmentFlow ~~~ AITutorFlow
    end

    GeminiAI["fa:fa-robot Gemini AI<br/>(External AI Service)"]

    Student --- UC_Browse
    Student --- UC_TakeTest
    Student --- UC_Submit
    Student --- UC_Review
    Student --- UC_Chat

    UC_Chat --- GeminiAI

    style Student fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0369a1
    style GeminiAI fill:#f3e8ff,stroke:#9333ea,stroke-width:2px,color:#6b21a8
    style SystemBoundary fill:#f8fafc,stroke:#475569,stroke-width:2px
    style AssessmentFlow fill:#ffffff,stroke:#cbd5e1,stroke-width:1px
    style AITutorFlow fill:#ffffff,stroke:#cbd5e1,stroke-width:1px
    style Row1 fill:#ffffff,stroke:none
    style Row2 fill:#ffffff,stroke:none
