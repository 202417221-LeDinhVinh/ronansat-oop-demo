%%{init: {
  "sequence": {
    "mirrorActors": false
  }
}}%%
sequenceDiagram
    actor Student
    participant C as SubmitAttemptController
    participant S as PracticeService
    participant F as ScoringStrategyFactory
    participant A as Attempt
    participant FS as FullLengthScoringStrategy

    Student->>C: POST /api/attempts/:id/submit
    Note over C: BaseController.handle():<br/>auth & parseAndValidate()
    C->>S: submitAttempt(attemptId, userId)
    S->>F: getStrategy(attempt.mode)
    F-->>S: strategy: FullLengthScoringStrategy
    S->>A: submit(strategy, questions, now)
    activate A
    A->>FS: score(attempt, questions)
    FS-->>A: scaledScore (1360)
    Note over A: Invariant: status = "submitted"
    deactivate A
