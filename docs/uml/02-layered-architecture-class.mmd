classDiagram
    direction LR

    class TestsRoute {
        +GET(req: Request)
        +POST(req: Request)
    }
    class TestController {
        +getTests(req: Request)
        +createTest(req: Request)
    }
    class TestService {
        +getTests(page, limit, sortBy, sortOrder)
        +createTest(data)
    }
    class TestValidationSchema {
        <<ZodSchema>>
        +parse(data) TestInput
    }
    class ITest {
        <<interface>>
        +title: string
        +timeLimit: number
        +difficulty: string
    }

    class QuestionsRoute {
        +GET(req: Request)
        +POST(req: Request)
    }
    class QuestionController {
        +getQuestions(req: Request)
        +createQuestion(req: Request)
    }
    class QuestionService {
        +getQuestions(testId)
        +createQuestion(data)
    }
    class QuestionValidationSchema {
        <<ZodSchema>>
        +parse(data) QuestionInput
    }
    class IQuestion {
        <<interface>>
        +section: string
        +questionText: string
        +choices: string[]
    }

    class ResultsRoute {
        +GET(req: Request)
        +POST(req: Request)
    }
    class ResultController {
        +getUserResults(req: Request)
        +createResult(req: Request)
    }
    class ResultService {
        +getUserResults(userId, days)
        +createResult(userId, data)
    }
    class ResultValidationSchema {
        <<ZodSchema>>
        +parse(data) ResultInput
    }
    class IResult {
        <<interface>>
        +userId: ObjectId
        +testId: ObjectId
        +score: number
    }

    class ChatRoute {
        +GET(req: Request)
        +POST(req: Request)
    }
    class ChatController {
        +getChat(req: Request)
        +postMessage(req: Request)
    }
    class ChatService {
        +getChatHistory(userId, questionId)
        +processMessage(userId, questionId, msg)
    }
    class IChat {
        <<interface>>
        +userId: ObjectId
        +questionId: ObjectId
        +messages: IMessage[]
    }

    %% Layered Dependency Flow (Left-to-Right)
    TestsRoute ..> TestController : delegates
    TestController ..> TestService : calls
    TestService ..> TestValidationSchema : validates
    TestService ..> ITest : persists

    QuestionsRoute ..> QuestionController : delegates
    QuestionController ..> QuestionService : calls
    QuestionService ..> QuestionValidationSchema : validates
    QuestionService ..> IQuestion : persists

    ResultsRoute ..> ResultController : delegates
    ResultController ..> ResultService : calls
    ResultService ..> ResultValidationSchema : validates
    ResultService ..> IResult : persists

    ChatRoute ..> ChatController : delegates
    ChatController ..> ChatService : calls
    ChatService ..> IChat : persists
