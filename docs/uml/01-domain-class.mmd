classDiagram
    direction LR

    class User {
        +ObjectId _id
        +string name
        +string email
        +string password
        +string role
        +ObjectId[] testsTaken
        +number highestScore
        +Date lastTestDate
        +ObjectId[] wrongQuestions
        +Date createdAt
        +Date updatedAt
    }

    class Chat {
        +ObjectId _id
        +ObjectId userId
        +ObjectId questionId
        +IMessage[] messages
        +Date createdAt
        +Date updatedAt
    }

    class IMessage {
        +string role
        +MessagePart[] parts
        +Date timestamp
    }

    class Question {
        +ObjectId _id
        +ObjectId testId
        +string section
        +number module
        +string questionText
        +string passage
        +string[] choices
        +string correctAnswer
        +string explanation
        +string difficulty
        +number points
        +string imageUrl
        +Date createdAt
        +Date updatedAt
    }

    class Test {
        +ObjectId _id
        +string title
        +number timeLimit
        +string difficulty
        +Section[] sections
        +ObjectId[] questions
        +Date createdAt
        +Date updatedAt
    }

    class Section {
        +string name
        +number questionsCount
        +number timeLimit
    }

    class Result {
        +ObjectId _id
        +ObjectId userId
        +ObjectId testId
        +boolean isSectional
        +string sectionalSubject
        +number sectionalModule
        +IAnswer[] answers
        +number score
        +Date date
        +Date createdAt
        +Date updatedAt
    }

    class IAnswer {
        +ObjectId questionId
        +string userAnswer
        +boolean isCorrect
    }

    class StudentCard {
        +ObjectId _id
        +string name
        +string school
        +number score
        +string examDate
        +string imageUrl
        +Date createdAt
        +Date updatedAt
    }

    %% Relationships and Multiplicities
    User "1" --> "0..*" Chat : participates
    Chat "1" *-- "0..*" IMessage : contains
    Chat "0..*" --> "1" Question : discusses
    User "1" --> "0..*" Result : submits
    Result "1" *-- "1..*" IAnswer : contains
    IAnswer "0..*" --> "1" Question : answers
    Result "0..*" --> "1" Test : evaluates
    Test "1" --> "0..*" Question : includes
    Test "1" *-- "1..*" Section : contains
