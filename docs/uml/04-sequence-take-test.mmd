sequenceDiagram
    autonumber
    actor Student
    participant Browser as Test UI (Next.js)
    participant API as API Routes (/api/*)
    participant Controller as Controllers (MVC)
    participant Service as Domain Services
    participant DB as MongoDB (Mongoose)

    %% 1. Loading Phase
    rect rgb(240, 249, 255)
        note over Student, DB: Phase 1: Test Initialization & Question Loading
        Student->>Browser: Selects test and navigates to /test/[id]
        activate Browser
        Browser->>API: GET /api/questions?testId={id}
        activate API
        API->>Controller: questionController.getQuestions(req)
        activate Controller
        Controller->>Service: questionService.getQuestions(testId)
        activate Service
        Service->>DB: Question.find({ testId })
        activate DB
        DB-->>Service: Return question documents
        deactivate DB
        Service-->>Controller: Return question array
        deactivate Service
        Controller-->>API: 200 OK ({ questions })
        deactivate Controller
        API-->>Browser: 200 OK JSON
        deactivate API
        Browser-->>Student: Renders TestEngine (Timer, Passage, Choices, Desmos)
        deactivate Browser
    end

    %% 2. Taking Test Phase
    rect rgb(254, 252, 232)
        note over Student, Browser: Phase 2: Active Test Taking
        loop For each Question in Section
            Student->>Browser: Selects choice / flags for review
            Browser->>Browser: Updates local state (answers[qId] = choice)
        end
    end

    %% 3. Submission Phase
    rect rgb(240, 253, 244)
        note over Student, DB: Phase 3: Test Submission, Result Persistence & Scoring
        Student->>Browser: Clicks "Submit Test"
        activate Browser
        Browser->>Browser: Evaluates answers against correct choices & computes score
        Browser->>API: POST /api/results (testId, answers, score, breakdown)
        activate API

        API->>Controller: resultController.createResult(req)
        activate Controller
        Controller->>Controller: getServerSession(authOptions) - verify student session

        Controller->>Service: resultService.createResult(userId, data)
        activate Service
        Service->>DB: Result.create({ userId, testId, answers, score, ... })
        activate DB
        DB-->>Service: Saved Result Document
        deactivate DB

        Service->>DB: User.findById(userId)
        activate DB
        DB-->>Service: User Document
        deactivate DB

        Service->>Service: Update testsTaken, highestScore, lastTestDate, wrongQuestions
        Service->>DB: user.save()
        activate DB
        DB-->>Service: User record updated
        deactivate DB

        Service-->>Controller: Return newResult
        deactivate Service

        Controller-->>API: 201 Created ({ result: newResult })
        deactivate Controller

        API-->>Browser: 201 Created JSON
        deactivate API

        Browser-->>Student: Displays Test Summary (SAT Score, Section Breakdown, Review CTA)
        deactivate Browser
    end
