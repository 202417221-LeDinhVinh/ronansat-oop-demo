classDiagram
    direction LR

    class Container {
        -instance$: Container
        +getInstance()$ Container
    }

    class IRepository~TEntity, TId~ {
        <<interface>>
        +findById(id)* Promise~TEntity~
        +save(entity)* Promise~TEntity~
        +delete(id)* Promise~boolean~
    }

    class MongoRepository~TEntity, TDoc~ {
        <<abstract>>
        #toEntity(doc)* TEntity
        #toDocument(entity)* object
        +findById(id) Promise~TEntity~
        +save(entity) Promise~TEntity~
        +delete(id) Promise~boolean~
    }

    class InMemoryRepository~TEntity, TId~ {
        <<abstract>>
        #items: Map
        #idPrefix: string*
        +findById(id) Promise~TEntity~
        +save(entity) Promise~TEntity~
        +delete(id) Promise~boolean~
    }

    class PasswordHasher {
        <<interface>>
        +hash(plain)* Promise~string~
        +compare(plain, hash)* Promise~boolean~
    }

    class BcryptPasswordHasher {
        -saltRounds: number
        +hash(plain) Promise~string~
    }

    class Clock {
        <<interface>>
        +now()* Date
    }

    class SystemClock {
        +now() Date
    }

    Container ..> IRepository
    Container ..> PasswordHasher
    Container ..> Clock

    IRepository <|.. MongoRepository
    IRepository <|.. InMemoryRepository
    PasswordHasher <|.. BcryptPasswordHasher
    Clock <|.. SystemClock
